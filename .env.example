# Web server
PORT=10000

# Supabase backend access (never expose the secret key in browser code)
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Admin authentication
# Generate with: npm run hash-password -- "your-new-password"
ADMIN_PASSWORD_HASH=
# Generate with: openssl rand -base64 48
SESSION_SECRET=

# Telegram bot (optional worker)
TELEGRAM_BOT_TOKEN=
TELEGRAM_ADMIN_CHAT_ID=
BOT_PORT=8081
MAIN_API_URL=http://localhost:10000
BOT_INTERNAL_API_KEY=
